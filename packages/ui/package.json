{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles.css"
  ],
  "exports": {
    "./styles.css": "./src/styles.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "dev": "tsc --watch"
  },
  "peerDependencies": {
    "react": "19.3.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "daisyui": "5.7.50",
    "tailwindcss": "4.3.3"
  }
}
