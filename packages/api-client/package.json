{
  "name": "@repo/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit",
    "generate": "openapi-typescript ../../services/rust/openapi.yaml -o src/generated/schema.ts --root-types --root-types-no-schema-prefix && biome check --write src/generated"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@repo/typescript-config": "workspace:*",
    "openapi-typescript": "7.13.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  }
}
